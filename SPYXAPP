    <!-- JavaScript Logic -->
    <script>
        // State Management
        let apps = JSON.parse(localStorage.getItem('spyxapp_apps')) || [];
        let currentCategory = 'Semua';
        let isOwnerLoggedIn = localStorage.getItem('spyxapp_owner_logged') === 'true';

        let ownerAccount = JSON.parse(localStorage.getItem('spyxapp_owner_account')) || {
            username: 'SPYXAPP',
            password: 'spyx123',
            siteTitle: 'SPYXAPP',
            siteBio: 'Platform unduhan perangkat lunak modern dengan tautan langsung, aman, cepat, dan terkurasi untuk produktivitas Anda.'
        };

        // Migration logic to ensure default credentials match the new rules
        if (ownerAccount.username === 'Pemilik' && ownerAccount.password === 'mysecretpassword123') {
            ownerAccount.username = 'SPYXAPP';
            ownerAccount.password = 'spyx123';
            localStorage.setItem('spyxapp_owner_account', JSON.stringify(ownerAccount));
        }

        // Apply UI configurations from State
        document.getElementById('nav-brand-title').textContent = ownerAccount.siteTitle;
        document.getElementById('page-title-meta').textContent = `${ownerAccount.siteTitle} - Direktori Aplikasi & Unduhan Modern`;
        
        const heroTitleSpan = document.querySelector('#hero-title span');
        if(heroTitleSpan) heroTitleSpan.textContent = ownerAccount.siteTitle;
        document.getElementById('hero-bio').textContent = ownerAccount.siteBio;

        // Toast Notification System
        let toastTimeout;
        function showToast(message, isError = false) {
            const toast = document.getElementById('toast');
            const msg = document.getElementById('toast-msg');
            const icon = document.getElementById('toast-icon');
            const iconContainer = icon.parentElement;
            
            msg.textContent = message;
            
            if (isError) {
                icon.className = "fa-solid fa-xmark text-rose-400";
                iconContainer.className = "w-8 h-8 rounded-full bg-rose-500/20 flex items-center justify-center flex-shrink-0";
            } else {
                icon.className = "fa-solid fa-check text-emerald-400";
                iconContainer.className = "w-8 h-8 rounded-full bg-emerald-500/20 flex items-center justify-center flex-shrink-0";
            }

            toast.classList.remove('translate-y-24', 'opacity-0');
            
            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                toast.classList.add('translate-y-24', 'opacity-0');
            }, 3500);
        }

        const canvas = document.getElementById('spectrum-canvas');
        const ctx = canvas.getContext('2d');
        let animationId;

        function initSpectrum() {
            function resize() {
                canvas.width = canvas.parentElement.offsetWidth;
                canvas.height = canvas.parentElement.offsetHeight;
            }
            resize();
            window.addEventListener('resize', resize);

            const barsCount = window.innerWidth < 768 ? 30 : 60;
            let time = 0;
            
            // Generate random offsets for natural variation
            const barOffsets = Array.from({length: barsCount}, () => Math.random() * Math.PI * 2);
            const barSpeeds = Array.from({length: barsCount}, () => 0.5 + Math.random() * 1.5);

            function draw() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                const barWidth = canvas.width / barsCount;
                time += 0.02;

                const isDark = document.documentElement.classList.contains('dark');

                for (let i = 0; i < barsCount; i++) {
                    // Combine sine waves for organic "audio" look
                    const wave1 = Math.sin(time * barSpeeds[i] + barOffsets[i]);
                    const wave2 = Math.sin(time * 0.5 + i * 0.1);
                    
                    // Normalize to 0-1
                    let heightFactor = (wave1 * 0.5 + wave2 * 0.5 + 1) / 2;
                    // Add emphasis to middle bars
                    const distFromCenter = Math.abs((i - barsCount/2) / (barsCount/2));
                    heightFactor = heightFactor * (1 - distFromCenter * 0.5);

                    const height = heightFactor * (canvas.height * 0.6) + 10;
                    const x = i * barWidth;
                    const y = canvas.height - height;

                    const gradient = ctx.createLinearGradient(0, y, 0, canvas.height);
                    if (isDark) {
                        gradient.addColorStop(0, 'rgba(16, 185, 129, 0.4)');
                        gradient.addColorStop(1, 'rgba(20, 184, 166, 0.01)');
                    } else {
                        gradient.addColorStop(0, 'rgba(16, 185, 129, 0.2)');
                        gradient.addColorStop(1, 'rgba(20, 184, 166, 0.0)');
                    }

                    ctx.fillStyle = gradient;
                    // Draw with slightly rounded tops using path
                    ctx.beginPath();
                    ctx.roundRect(x + 2, y, barWidth - 4, height, [4, 4, 0, 0]);
                    ctx.fill();
                }
                animationId = requestAnimationFrame(draw);
            }
            draw();
        }
        initSpectrum();

        function toggleTheme() {
            const html = document.documentElement;
            const icon = document.getElementById('theme-icon');
            if (html.classList.contains('dark')) {
                html.classList.remove('dark');
                icon.className = "fa-solid fa-sun text-amber-500";
            } else {
                html.classList.add('dark');
                icon.className = "fa-solid fa-moon text-slate-300";
            }
        }

        // Get initial letters for App Icon
        function getInitials(name) {
            return name.substring(0, 2).toUpperCase();
        }

        // Generate consistent gradient colors based on string
        function getGradientColors(str) {
            let hash = 0;
            for (let i = 0; i < str.length; i++) hash = str.charCodeAt(i) + ((hash << 5) - hash);
            const palettes = [
                ['from-emerald-400', 'to-teal-600'],
                ['from-blue-400', 'to-indigo-600'],
                ['from-purple-400', 'to-fuchsia-600'],
                ['from-rose-400', 'to-orange-500'],
                ['from-amber-400', 'to-red-500']
            ];
            return palettes[Math.abs(hash) % palettes.length];
        }

        function updateAuthUI() {
            const btnAdd = document.getElementById('btn-add-app');
            const authContainer = document.getElementById('auth-action-container');

            if (isOwnerLoggedIn) {
                btnAdd.classList.remove('hidden');
                btnAdd.classList.add('flex');
                authContainer.innerHTML = `
                    <div class="flex items-center space-x-2">
                        <button onclick="openSettingsModal()" class="px-4 py-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 font-semibold text-emerald-600 dark:text-emerald-400 transition-all flex items-center space-x-2" title="Pengaturan Akun">
                            <i class="fa-solid fa-gear"></i>
                            <span class="hidden md:inline">${ownerAccount.username}</span>
                        </button>
                        <button onclick="handleLogout()" class="px-4 py-2.5 rounded-xl border border-rose-200 dark:border-rose-900/50 hover:bg-rose-50 dark:hover:bg-rose-900/30 text-rose-500 font-semibold transition-all" title="Keluar">
                            <i class="fa-solid fa-power-off"></i>
                        </button>
                    </div>
                `;
            } else {
                btnAdd.classList.add('hidden');
                btnAdd.classList.remove('flex');
                authContainer.innerHTML = `
                    <button onclick="openLoginModal()" class="px-4 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 font-semibold text-sm transition-all">
                        Masuk Pemilik
                    </button>
                `;
            }
        }
        updateAuthUI();

        function renderApps(list = apps) {
            const grid = document.getElementById('app-grid');
            if (list.length === 0) {
                grid.innerHTML = `
                    <div class="col-span-full flex flex-col items-center justify-center py-20 px-4 text-center">
                        <div class="w-32 h-32 mb-6 text-slate-300 dark:text-slate-700">
                            <svg fill="currentColor" viewBox="0 0 24 24"><path d="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM19 18H6c-2.21 0-4-1.79-4-4s1.79-4 4-4h.71C7.37 7.69 9.48 6 12 6c3.04 0 5.5 2.46 5.5 5.5v.5H19c1.66 0 3 1.34 3 3s-1.34 3-3 3z"/></svg>
                        </div>
                        <h3 class="text-2xl font-bold text-slate-700 dark:text-slate-300 mb-2">Belum Ada Aplikasi</h3>
                        <p class="text-slate-500 max-w-md mx-auto">${isOwnerLoggedIn ? 'Gunakan tombol "Unggah" di atas untuk menambahkan aplikasi baru ke direktori.' : 'Aplikasi belum diunggah oleh pemilik website. Silakan kembali lagi nanti.'}</p>
                    </div>
                `;
                return;
            }

            grid.innerHTML = list.map(app => {
                const gradient = getGradientColors(app.name);
                return `
                <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-6 flex flex-col justify-between shadow-sm hover:shadow-2xl hover:-translate-y-1 transition-all duration-300 group">
                    <div>
                        <div class="flex items-start space-x-4 mb-5">
                            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br ${gradient[0]} ${gradient[1]} flex items-center justify-center text-white font-bold text-xl flex-shrink-0 shadow-lg">
                                ${getInitials(app.name)}
                            </div>
                            <div class="flex-grow">
                                <div class="flex items-center justify-between">
                                    <h3 class="text-lg font-bold text-slate-900 dark:text-white group-hover:text-emerald-500 transition-colors line-clamp-1">${app.name}</h3>
                                </div>
                                <span class="inline-block mt-1 px-2.5 py-0.5 rounded-md text-[10px] font-bold uppercase tracking-wider bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 border border-slate-200 dark:border-slate-700">
                                    ${app.category}
                                </span>
                            </div>
                        </div>
                        
                        <p class="text-slate-600 dark:text-slate-400 text-sm mb-5 line-clamp-2 leading-relaxed">${app.description}</p>
                        
                        <div class="flex flex-wrap gap-2 text-xs text-slate-500 dark:text-slate-400 mb-6 pb-5 border-b border-slate-100 dark:border-slate-800/80">
                            <span class="bg-slate-50 dark:bg-slate-950 px-2.5 py-1.5 rounded-lg flex items-center"><i class="fa-solid fa-desktop mr-1.5 text-slate-400"></i> ${app.platform}</span>
                            <span class="bg-slate-50 dark:bg-slate-950 px-2.5 py-1.5 rounded-lg flex items-center"><i class="fa-solid fa-hard-drive mr-1.5 text-slate-400"></i> ${app.size}</span>
                            <span class="bg-slate-50 dark:bg-slate-950 px-2.5 py-1.5 rounded-lg flex items-center font-medium text-slate-700 dark:text-slate-300">${app.version}</span>
                        </div>
                    </div>
                    
                    <div>
                        <div class="flex items-center justify-between">
                            <div class="flex items-center space-x-2">
                                <button onclick="shareApp(${app.id})" class="w-10 h-10 rounded-xl bg-slate-50 dark:bg-slate-800 hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 flex items-center justify-center transition-all group/btn" title="Bagikan">
                                    <i class="fa-solid fa-share-nodes group-hover/btn:text-emerald-500 transition-colors"></i>
                                </button>
                                ${isOwnerLoggedIn ? `
                                    <button onclick="openEditModal(${app.id})" class="w-10 h-10 rounded-xl bg-amber-50 dark:bg-amber-900/20 hover:bg-amber-100 dark:hover:bg-amber-900/40 text-amber-600 dark:text-amber-500 flex items-center justify-center transition-all" title="Edit">
                                        <i class="fa-solid fa-pen text-sm"></i>
                                    </button>
                                    <button onclick="deleteApp(${app.id})" class="w-10 h-10 rounded-xl bg-rose-50 dark:bg-rose-900/20 hover:bg-rose-100 dark:hover:bg-rose-900/40 text-rose-600 dark:text-rose-500 flex items-center justify-center transition-all" title="Hapus">
                                        <i class="fa-solid fa-trash text-sm"></i>
                                    </button>
                                ` : ''}
                            </div>
                            
                            <a href="${app.url}" target="_blank" class="px-5 py-2.5 rounded-xl bg-slate-900 dark:bg-white hover:bg-slate-800 dark:hover:bg-slate-200 text-white dark:text-slate-900 text-sm font-bold transition-all shadow-lg flex items-center space-x-2">
                                <span>Unduh</span>
                                <i class="fa-solid fa-arrow-down text-xs"></i>
                            </a>
                        </div>
                    </div>
                </div>
            `}).join('');
        }

        function shareApp(id) {
            const app = apps.find(a => a.id === id);
            if (!app) return;
            
            const shareText = `Unduh ${app.name} (${app.version}) - ${app.description}\nLink: ${app.url}`;
            
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(shareText).then(() => {
                    showToast(`Tautan "${app.name}" disalin!`);
                }).catch(() => {
                    fallbackShare(shareText);
                });
            } else {
                fallbackShare(shareText);
            }
        }

        function fallbackShare(text) {
            const el = document.createElement('textarea');
            el.value = text;
            document.body.appendChild(el);
            el.select();
            document.execCommand('copy');
            document.body.removeChild(el);
            showToast("Tautan disalin ke papan klip!");
        }

        function filterCategory(category) {
            currentCategory = category;
            document.querySelectorAll('.category-btn').forEach(btn => {
                if (btn.textContent.trim() === category || (category === 'Semua' && btn.textContent.trim() === 'Semua Aplikasi')) {
                    btn.className = "category-btn px-5 py-2.5 rounded-full text-sm font-semibold bg-emerald-600 text-white transition-all shadow-md shadow-emerald-500/20 whitespace-nowrap";
                } else {
                    btn.className = "category-btn px-5 py-2.5 rounded-full text-sm font-semibold bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:border-emerald-500 dark:hover:border-emerald-500 hover:text-emerald-600 dark:hover:text-emerald-400 transition-all whitespace-nowrap shadow-sm";
                }
            });
            filterApps();
        }

        function filterApps() {
            const query = document.getElementById('search-input').value.toLowerCase();
            const filtered = apps.filter(app => {
                const matchesCategory = currentCategory === 'Semua' || app.category === currentCategory;
                const matchesQuery = app.name.toLowerCase().includes(query) || app.description.toLowerCase().includes(query) || app.category.toLowerCase().includes(query);
                return matchesCategory && matchesQuery;
            });
            renderApps(filtered);
        }

        function animateModalOpen(modalId, contentId = null) {
            const modal = document.getElementById(modalId);
            modal.classList.remove('hidden');
            // Small delay for CSS transition to bite
            setTimeout(() => {
                if (contentId) {
                    const content = document.getElementById(contentId);
                    if(content) content.classList.replace('scale-95', 'scale-100');
                }
            }, 10);
        }

        function animateModalClose(modalId, contentId = null) {
            if (contentId) {
                const content = document.getElementById(contentId);
                if(content) content.classList.replace('scale-100', 'scale-95');
            }
            setTimeout(() => {
                document.getElementById(modalId).classList.add('hidden');
            }, 150); // wait for scale animation
        }

        function openLoginModal() { 
            document.getElementById('login-username').value = '';
            document.getElementById('login-password').value = '';
            animateModalOpen('login-modal', 'login-modal-content'); 
        }
        function closeLoginModal() { animateModalClose('login-modal', 'login-modal-content'); }

        function openSettingsModal() {
            document.getElementById('settings-username').value = ownerAccount.username;
            document.getElementById('settings-password').value = "";
            document.getElementById('settings-title').value = ownerAccount.siteTitle;
            document.getElementById('settings-bio').value = ownerAccount.siteBio;
            animateModalOpen('settings-modal');
        }
        function closeSettingsModal() { animateModalClose('settings-modal'); }

        function openAddModal() {
            if (!isOwnerLoggedIn) {
                showToast("Akses ditolak! Silakan masuk terlebih dahulu.", true);
                openLoginModal();
                return;
            }
            document.getElementById('modal-app-title').textContent = "Tambah Aplikasi";
            document.getElementById('app-edit-id').value = "";
            document.getElementById('app-form').reset();
            animateModalOpen('add-modal');
        }

        function openEditModal(id) {
            if (!isOwnerLoggedIn) return;
            const app = apps.find(a => a.id === id);
            if (!app) return;
            document.getElementById('modal-app-title').textContent = "Edit Aplikasi";
            document.getElementById('app-edit-id').value = app.id;
            document.getElementById('app-name').value = app.name;
            document.getElementById('app-category').value = app.category;
            document.getElementById('app-platform').value = app.platform;
            document.getElementById('app-size').value = app.size;
            document.getElementById('app-version').value = app.version;
            document.getElementById('app-url').value = app.url;
            document.getElementById('app-desc').value = app.description;
            animateModalOpen('add-modal');
        }

        function closeAddModal() { animateModalClose('add-modal'); }

        function handleLogin(e) {
            e.preventDefault();
            const usernameInput = document.getElementById('login-username').value.trim();
            const passwordInput = document.getElementById('login-password').value;

            if (usernameInput === ownerAccount.username && passwordInput === ownerAccount.password) {
                isOwnerLoggedIn = true;
                localStorage.setItem('spyxapp_owner_logged', 'true');
                closeLoginModal();
                updateAuthUI();
                renderApps(apps);
                showToast("Selamat datang kembali, Pemilik!");
            } else {
                showToast("Username atau kata sandi tidak valid!", true);
            }
        }

        function handleLogout() {
            isOwnerLoggedIn = false;
            localStorage.setItem('spyxapp_owner_logged', 'false');
            updateAuthUI();
            renderApps(apps);
            showToast("Berhasil keluar sistem.");
        }

        function handleSaveSettings(e) {
            e.preventDefault();
            const newUsername = document.getElementById('settings-username').value.trim();
            const newPassword = document.getElementById('settings-password').value;
            const newTitle = document.getElementById('settings-title').value.trim();
            const newBio = document.getElementById('settings-bio').value.trim();

            ownerAccount.username = newUsername;
            if (newPassword) ownerAccount.password = newPassword;
            ownerAccount.siteTitle = newTitle;
            ownerAccount.siteBio = newBio;

            localStorage.setItem('spyxapp_owner_account', JSON.stringify(ownerAccount));
            
            document.getElementById('nav-brand-title').textContent = ownerAccount.siteTitle;
            document.getElementById('page-title-meta').textContent = `${ownerAccount.siteTitle} - Direktori Aplikasi`;
            const heroTitleSpan = document.querySelector('#hero-title span');
            if(heroTitleSpan) heroTitleSpan.textContent = ownerAccount.siteTitle;
            document.getElementById('hero-bio').textContent = ownerAccount.siteBio;

            closeSettingsModal();
            updateAuthUI();
            showToast("Pengaturan berhasil disimpan.");
        }

        function handleSaveApp(e) {
            e.preventDefault();
            if (!isOwnerLoggedIn) {
                showToast("Akses ditolak!", true);
                return;
            }

            const editId = document.getElementById('app-edit-id').value;
            const appData = {
                name: document.getElementById('app-name').value.trim(),
                category: document.getElementById('app-category').value,
                platform: document.getElementById('app-platform').value.trim(),
                size: document.getElementById('app-size').value.trim(),
                version: document.getElementById('app-version').value.trim(),
                url: document.getElementById('app-url').value.trim(),
                description: document.getElementById('app-desc').value.trim()
            };

            if (editId) {
                apps = apps.map(app => app.id == editId ? { ...app, ...appData } : app);
                showToast("Aplikasi diperbarui!");
            } else {
                const newApp = {
                    id: Date.now(),
                    ...appData
                };
                apps.unshift(newApp);
                showToast("Aplikasi berhasil ditambahkan!");
            }

            localStorage.setItem('spyxapp_apps', JSON.stringify(apps));
            closeAddModal();
            filterApps();
        }

        function deleteApp(id) {
            if (!isOwnerLoggedIn) return;
            // Removed confirm() as per constraints. Direct deletion with visual feedback via toast.
            apps = apps.filter(app => app.id !== id);
            localStorage.setItem('spyxapp_apps', JSON.stringify(apps));
            filterApps();
            showToast("Aplikasi telah dihapus.");
        }

        // Initialize Render
        renderApps();
    </script>
</body>
</html>
